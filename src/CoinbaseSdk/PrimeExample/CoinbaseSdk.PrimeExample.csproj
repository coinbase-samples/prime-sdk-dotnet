<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="../Prime/CoinbaseSdk.Prime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CoinbaseSdk.Core" Version="0.0.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Exclude example files from compilation - they are documentation/reference only -->
  <ItemGroup>
    <Compile Remove="examples/**/*.cs" />
    <None Include="examples/**/*.cs" />
  </ItemGroup>

</Project>
